{
    "disabled_providers": [
        "amazon-bedrock",
        "vultr"
    ],
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "build",
    "model": "opencode-go/qwen3.5-plus",
    "agent": {
        "plan": {
            "mode": "primary",
            "model": "opencode/gpt-5.1"
        },
        "build": {
            "mode": "primary",
            "model": "opencode-go/minimax-m2.7"
        },
        "general": {
            "mode": "subagent",
            "model": "opencode-go/qwen3.5-plus",
            "description": "General questions and help (cheap, fast)"
        },
        "explore": {
            "mode": "subagent",
            "model": "opencode-go/mimo-v2.5",
            "description": "Fast code exploration"
        },
        "review": {
            "mode": "subagent",
            "model": "opencode/gpt-5.1",
            "description": "PR review and deep logic verification"
        },
        "fallback": {
            "mode": "subagent",
            "model": "opencode/minimax-m2.5-free",
            "description": "Free fallback when premium credits are low"
        }
    }
}
