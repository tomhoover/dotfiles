# changes to tmux-sensible stuff {{{
# increase scrollback buffer size
set-option -g history-limit 50000

# tmux messages are displayed for 3 seconds
set-option -g display-time 3000

# Easier and faster switching between next/prev window
#   enhance the default prefix + p and prefix + n bindings by allowing you to hold Ctrl and repeat a + p/a + n (if your prefix is C-a), which is a lot quicker.
%if #{>=:#{version},3.1}
bind-key -N 'Next window' C-n next-window
bind-key -N 'Previous window' C-p previous-window
%endif
# }}}

# my stuff {{{

%if #{>=:#{version},3.1}
bind-key -N 'Select the last (previously selected) window' C-a last-window
bind-key -N 'Select the next window' space next-window
bind-key -N 'Select the next window' C-space next-window
bind-key -N 'Kill pane (with confirmation)' K confirm-before kill-pane
bind-key -N 'Kill session (with confirmation)' '\' confirm-before kill-session
bind-key -N 'Join the last active pane to the currently active window' j join-pane -s !
bind-key -N 'Join the marked pane to the currently active window' J join-pane
bind-key -N 'Move current window to session named "bg" (and create session if it does not exist)' B if-shell "! tmux has-session -t bg" "new-session -d -s bg" \; move-window -t bg
bind-key -N 'Reload config' R source-file ~/.tmux.conf \; source-file -q ~/.tmux.conf.local \; display-message '~/.tmux.conf[.local] reloaded'
bind-key -N 'Select the next layout' h next-layout
bind-key -N 'Select the previous window' BSpace previous-window
bind-key -N 'Select next pane' tab select-pane -t :.+
bind-key -N 'Split window horizontally & prompt for command' | command-prompt -p "exec:" "split-window -h '%%'"
bind-key -N 'Split window vertically & prompt for command' - command-prompt -p "exec:" "split-window -v '%%'"
%endif

# unbind-key C-b
unbind-key C-a
# remove the following line when I've learned the new tmux prefix
bind-key -n -N 'Reminder that C-Space is now the tmux prefix' C-a display-message "Reminder that C-Space is now the tmux prefix"
set-option -g prefix C-Space
bind-key -N 'Select the last (previously selected) window' C-Space last-window

bind-key -N 'Toggle mouse mode' M-m set -g mouse\; display-message "mouse is now #{?mouse,on,off}"
bind-key -N 'Toggle synchronize panes' M-s set-window-option synchronize-panes\; display-message "synchronize-panes is now #{?pane_synchronized,on,off}"

# https://www.bugsnag.com/blog/tmux-and-vim
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"

# https://nickjanetakis.com/blog/start-your-tmuxt-window-and-pane-index-count-at-1-instead-of-0
# Start windows and panes index at 1, not 0.
set -g base-index 1
set-window-option -g pane-base-index 1

# Ensure window index numbers get reordered on delete.
set-option -g renumber-windows on

### set status line appearance
set -g status-style fg=white,bg=#282A36
set-window-option -g window-status-style fg=blue,bg=#282A36

set -g default-terminal "tmux-256color"

# }}}

# Plugins {{{

# Smart pane switching with awareness of Vim splits.
 # See: https://github.com/christoomey/vim-tmux-navigator
 vim_pattern='(\S+/)?g?\.?(view|l?n?vim?x?|fzf)(diff)?(-wrapped)?'
 # Workaround to is_vim not working with kiro-cli
 # Issue: https://github.com/christoomey/vim-tmux-navigator/issues/460
 # Solution: https://github.com/christoomey/vim-tmux-navigator/issues/295#issuecomment-2689782437
 is_vim="\
     ps -eo pid=,ppid=,stat=,comm= | \
     awk -v pid=#{pane_pid} '\
         ($3 !~ /^T/) \
         { \
             pid_array[$1]=$2; \
             name_array[$1]=$4; \
         }\
         END \
         { \
             for (p in pid_array) { \
                 current_pid = p; \
                 while (current_pid && current_pid != \"0\") { \
                     if (current_pid == pid && name_array[p] ~ /(^|\\/)([gn]?vim?x?)(diff)?/) {
                         exit 0 \
                     } \
                     current_pid = pid_array[current_pid]; \
                 } \
             } \
             exit 1 \
         }' \
 "
 bind-key -n 'C-h' if-shell "$is_vim" 'send-keys C-h'  'select-pane -L'
 bind-key -n 'C-j' if-shell "$is_vim" 'send-keys C-j'  'select-pane -D'
 bind-key -n 'C-k' if-shell "$is_vim" 'send-keys C-k'  'select-pane -U'
 bind-key -n 'C-l' if-shell "$is_vim" 'send-keys C-l'  'select-pane -R'
 tmux_version='$(tmux -V | sed -En "s/^tmux ([0-9]+(.[0-9]+)?).*/\1/p")'
 if-shell -b '[ "$(echo "$tmux_version < 3.0" | bc)" = 1 ]' \
     "bind-key -n 'C-\\' if-shell \"$is_vim\" 'send-keys C-\\'  'select-pane -l'"
 if-shell -b '[ "$(echo "$tmux_version >= 3.0" | bc)" = 1 ]' \
     "bind-key -n 'C-\\' if-shell \"$is_vim\" 'send-keys C-\\\\'  'select-pane -l'"

 bind-key -T copy-mode-vi 'C-h' select-pane -L
 bind-key -T copy-mode-vi 'C-j' select-pane -D
 bind-key -T copy-mode-vi 'C-k' select-pane -U
 bind-key -T copy-mode-vi 'C-l' select-pane -R
 bind-key -T copy-mode-vi 'C-\' select-pane -l

set-environment -g TMUX_PLUGIN_MANAGER_PATH "$HOME/.local/share/tmux/plugins"
# Automatic tpm installation
if 'test ! -d "${TMUX_PLUGIN_MANAGER_PATH}/tpm"' {
  run 'mkdir -p "${TMUX_PLUGIN_MANAGER_PATH}"'
  run 'git clone https://github.com/tmux-plugins/tpm "${TMUX_PLUGIN_MANAGER_PATH}/tpm"'
  run '${TMUX_PLUGIN_MANAGER_PATH}/tpm/bin/install_plugins'
}

# set -g @resurrect-dir "$HOME/.local/share/tmux/resurrect"
set -g @continuum-restore 'on'

# List of plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
# set -g @plugin 'dracula/tmux'
# set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'laktak/extrakto'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum' # keep this plugin last in the TPM plugins list

# Initialize TMUX plugin manager (keep this line at the very bottom of tmux.conf)
# run '~/.local/share/tmux/plugins/tpm/tpm'
run '${TMUX_PLUGIN_MANAGER_PATH}/tpm/tpm'

# }}}

