# http://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[Makefile]
indent_style = tab

[config]
indent_size = 4
indent_style = space

[shell]
binary_next_line   = true
function_next_line = true
switch_case_indent = true

[*.{c,h,cmake,txt}]
indent_size = 4
indent_style = tab

[*.{xml,yml}]
indent_size = 2
indent_style = space

[*.md]
trim_trailing_whitespace = false
