# shellcheck shell=sh

[ "$DOTFILE_DEBUG" ] && echo "$PATH" >>/tmp/shell-init.txt
[ "$DOTFILE_DEBUG" ] && echo "$(date '+%Y-%m-%d %H:%M') :: :: DARWIN_ENVS_LOADED" | tee -a /tmp/shell-init.txt
export DARWIN_ENVS_LOADED=1

# instruct Homebrew to return to pre-4.0.0 behaviour by cloning the Homebrew/homebrew-core tap during installation
# https://docs.brew.sh/Installation
export HOMEBREW_NO_INSTALL_FROM_API=1

# MacPorts
export PATH="/opt/local/bin:/opt/local/sbin:$PATH"
export MANPATH="/opt/local/share/man:$MANPATH"

[ "$DOTFILE_DEBUG" ] && echo "$(date '+%Y-%m-%d %H:%M') :: :: DARWIN_ENVS_ENDED" | tee -a /tmp/shell-init.txt
