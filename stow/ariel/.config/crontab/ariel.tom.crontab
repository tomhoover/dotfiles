SHELL=/bin/bash
LC_ALL=en_US.UTF-8
PATH=/Users/tom/bin:/Users/tom/.local/share/mise/shims:/opt/homebrew/bin:/opt/homebrew/sbin:/Users/tom/.local/bin:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin

# min hr dom mon dow command

0 0 * * *           echo > $HOME/tmp/crontab.log 2>&1
# * * * * *           echo "$PATH" >> $HOME/tmp/crontab.log 2>&1
# * * * * *           $HOME/bin/,backup-podman >> $HOME/tmp/crontab.log 2>&1
5 * * * *           tailscale status >/dev/null || $HOME/bin/,pushover "tailscale down" "ariel crontab"
5 * * * *           [ -d /Volumes/IRONKEY64 ] && /usr/bin/find /Volumes/IRONKEY64 -name '._*' -delete > /dev/null 2>&1
5 * * * *           [ -d /Volumes/Ventoy ] && /usr/bin/find /Volumes/Ventoy -name '._*' -delete > /dev/null 2>&1
* * * * *           [ $HOME/dl/fund-price-history.csv -nt $HOME/dl/shareprices.csv ] && head -1 $HOME/dl/fund-price-history.csv | grep '^Date,L Income' >/dev/null 2>&1 && head -260 $HOME/dl/fund-price-history.csv > $HOME/dl/shareprices.csv

0-59/5 * * * *      $HOME/bin/,vault                             && curl -fsS -m 10 --retry 5 -o /dev/null https://hc-ping.com/f3822332-5576-4fd1-ba01-985edb9d785c

0 7 * * *           /bin/ls $HOME/.ansible/TODO.* 2> /dev/null   && cd $HOME/.ansible/ && ls -x TODO.* | $HOME/bin/,pushover

30 */4    * * 1-6   $HOME/bin/,duplicacy-backup > /dev/null 2>&1 && curl -fsS -m 10 --retry 5 -o /dev/null https://hc-ping.com/a4ae04ec-5a0e-4ada-8597-64d9f29bbfa4
30 0-16/4 * * Sun   $HOME/bin/,duplicacy-backup > /dev/null 2>&1 && curl -fsS -m 10 --retry 5 -o /dev/null https://hc-ping.com/a4ae04ec-5a0e-4ada-8597-64d9f29bbfa4
30 20     * * Sun   $HOME/bin/,duplicacy-backup                  && curl -fsS -m 10 --retry 5 -o /dev/null https://hc-ping.com/a4ae04ec-5a0e-4ada-8597-64d9f29bbfa4

@daily              find $HOME/.ansible/inventory -name '*.tmp' -type f -mtime +7 -delete
@daily              find $HOME/.ssh/config.d      -name '*.tmp' -type f -mtime +7 -delete
@daily              $HOME/bin/,backup-docker    > /dev/null 2>&1 && curl -fsS -m 10 --retry 5 -o /dev/null https://hc-ping.com/19504779-0fca-432b-af2d-72e7e3b5c525
@daily              $HOME/bin/,backup-podman    > /dev/null 2>&1 && curl -fsS -m 10 --retry 5 -o /dev/null https://hc-ping.com/2d477405-f106-4777-915c-99d9666df209
@daily              $HOME/bin/,find-git-repos   > /dev/null 2>&1 && curl -fsS -m 10 --retry 5 -o /dev/null https://hc-ping.com/9bceef67-b57c-498d-b6b1-4497ae91d472
@daily              $HOME/bin/,rsync-backup     > /dev/null 2>&1 && curl -fsS -m 10 --retry 5 -o /dev/null https://hc-ping.com/63bce5e5-76ff-4e93-8d5e-06f76ea62aa6

0  0      * * Sun   $HOME/bin/,homebrewBackup_weekly             && curl -fsS -m 10 --retry 5 -o /dev/null https://hc-ping.com/592f1312-2d83-4f93-a1c1-a396b94011a2
@weekly             rsync -qcltz --block-size=8192 --partial --progress --exclude=emeritus-* --exclude=removed-* keyring.debian.org::keyrings/keyrings/* $HOME/.debian-keyring   && curl -fsS -m 10 --retry 5 -o /dev/null https://hc-ping.com/6eb38636-afaa-4f85-9d63-63a3d5139c0f
@weekly             cat $HOME/.ssh/id_ed25519_ariel.pub $HOME/.ssh/id_ed25519_bethel.pub $HOME/.ssh/id_ed25519_theophilus.pub $HOME/.ssh/id_rsa.pub $HOME/.ssh/id_rsa_arch.pub $HOME/.ssh/id_rsa_ariel.pub $HOME/.ssh/id_rsa_bethel.pub $HOME/.ssh/id_rsa_manuel.pub $HOME/.ssh/id_rsa_theophilus.pub $HOME/.ssh/ansible_rsa.pub $HOME/.ssh/terraform_rsa.pub > $HOME/.ssh/authorized_keys.lxc   && curl -fsS -m 10 --retry 5 -o /dev/null https://hc-ping.com/5b25f474-490f-4748-83da-00b6404a273a
@weekly             $HOME/.ansible/roles/user-config/files/get-grml-files.sh

