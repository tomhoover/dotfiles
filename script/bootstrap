#!/usr/bin/env bash

[ "$(id -u)" -eq 0 ] && {
  echo "Run $0 as yourself (not as root), exiting"
  exit 1
}

MYHOST=$(uname -n | sed -e 's/\..*//') # alternative to $(hostname -s), as arch does not install 'hostname' by default

STOW_DOTFILES=( #{{{
  .aliases
  .bash_profile
  .bash_logout
  .bashrc
  .envs
  .functions
  .profile
  .zprofile
  .zshenv
  .zshrc
  .zshrc.local
  .config/ghostty/config
  .config/kitty/kitty.conf
  .config/starship.toml
) #}}}

REQUIRED_PKGS=( #{{{
  git
  myrepos
  stow
  vcsh
) #}}}

COMMON_PKGS=( #{{{
  colordiff
  diff-so-fancy
  fzf
  ghostty
  keychain
  mc
  mosh
  tmux
  tree
  vim
  yazi
  zoxide
) #}}}

ARCH_PKGS=( #{{{
  base-devel
  ex-vi-compat
  interception-caps2esc
  tailscale
  zsh
) #}}}

AUR_PKGS=( #{{{
  brave-bin
  p4merge-bin
  paru
  # vi-vim-symlink
) #}}}

DARWIN_PKGS=( #{{{
  brave-browser
  tailscale-app
) #}}}

DEBIAN_PKGS=( #{{{
  tailscale
  zsh
) #}}}

FEDORA_PKGS=( #{{{
  tailscale
  zsh
) #}}}

# Only use COLORS in interactive shells, not from crontab #{{{
# shellcheck disable=SC2034
if [ -t 1 ]; then
    RED=$(tput setaf 1)
    GREEN=$(tput setaf 2)
    YELLOW=$(tput setaf 3)
    BLUE=$(tput setaf 4)
    MAGENTA=$(tput setaf 5)
    CYAN=$(tput setaf 6)
    RESET=$(tput sgr0)
else
    RED=
    GREEN=
    YELLOW=
    BLUE=
    MAGENTA=
    CYAN=
    RESET=
fi
#}}}

error() { #{{{
  echo "${RED}✘ ERROR: $*${RESET}" >&2
} #}}}

warn() { #{{{
  echo "${YELLOW}‼ WARNING: $*${RESET}"
} #}}}

info() { #{{{
  echo "${CYAN} $*${RESET}"
} #}}}

success() { #{{{
  echo "${GREEN}✔ $*${RESET}"
} #}}}

isdarwin() { #{{{
  [ "$(uname -s)" = "Darwin" ]
} #}}}

islinux() { #{{{
  [ "$(uname -s)" = "Linux" ]
} #}}}

isarch() { #{{{
  if islinux && [ -f /etc/os-release ]; then
    # shellcheck disable=SC1091
    source /etc/os-release
    # shellcheck disable=SC2078
    [ "${ID}" = "arch" ] && return 0
  fi
  return 1
} #}}}

isdebian() { #{{{
  if islinux && [ -f /etc/os-release ]; then
    # shellcheck disable=SC1091
    source /etc/os-release
    # shellcheck disable=SC2078
    [ "${ID}" = "debian" ] && return 0
  fi
  return 1
} #}}}

isfedora() { #{{{
    if islinux && [ -f /etc/os-release ]; then
        # shellcheck disable=SC1091
        . /etc/os-release
        # shellcheck disable=SC2078
        [ "${ID}" = "fedora" ] && return 0
    fi
    return 1
} #}}}

isomarchy() { #{{{
  isarch && grep -q '\[omarchy\]' /etc/pacman.conf
} #}}}

iszsh() { #{{{
  [ "${SHELL}" = "/bin/zsh" ]
} #}}}

###

create_ssh_key() { #{{{
  if [ ! "$(id -u)" -eq 0 ] && [ ! -f ~/.ssh/id_rsa_"${MYHOST}".pub ]; then
    echo
    success "Creating ssh key for ${MYHOST}..."
    echo && ssh-keygen -t rsa -b 4096 -C "$(whoami)@${MYHOST}" -f "${HOME}"/.ssh/id_rsa_"${MYHOST}"
    export NEW_SSH_KEY=1
  fi
} #}}}

clone_apt_vcsh() { #{{{
  if isdebian; then
    github_vclone apt
    sudo aptitude install "$(cat ~/.config/apt/installed)"
    sudo apt-mark manual "$(cat ~/.config/apt/installed)" # this line is probably not needed, but added for good measure
  fi
} #}}}

# shellcheck disable=SC2329
backup_file() { #{{{
  success "Backing up ${1}..."
  # shellcheck disable=SC2086
  mkdir -p "$HOME/.backup-$(date '+%Y%m%d')/$(dirname ${1})"
  # shellcheck disable=SC2086
  mv "$HOME/${1}" "$HOME/.backup-$(date '+%Y%m%d')/$(dirname ${1})"
  echo "nvim -d $HOME/.backup-$(date '+%Y%m%d')/${1} $HOME/${1}" >>"$HOME/fixups.sh"
} #}}}

# # bash/zsh function exporting shortcut
export -f backup_file

# Export the function (POSIX syntax -- preserve newlines and syntax!) #{{{
# shellcheck disable=SC2016
# export backup_file='backup_file()
# {
#   echo "Backing up ${1}..."
#   mkdir -p "$HOME/.backup-$(date '+%Y%m%d')/$(dirname ${1})"
#   mv "$HOME/${1}" "$HOME/.backup-$(date '+%Y%m%d')/$(dirname ${1})"
#   echo "nvim -d $HOME/.backup-$(date '+%Y%m%d')/${1} ${1}" >>"$HOME/fixups.sh"
# }'
# }}}

github_vclone() { #{{{
  if $BIN/vcsh clone "https://github.com/tomhoover/${1}-vcsh.git" "${1}"; then
    $BIN/vcsh "${REPO}" config get core.bare && $BIN/vcsh "${REPO}" config set core.bare false
    success "${1} successfully cloned..."
    return 0
  elif $BIN/vcsh "${1}" pull; then
    success "${1} successfully updated via pull..."
    return 0
  else
    error "Conflicting files found..."
    # $BIN/vcsh "${1}" pull 2>&1 | grep -E '^\s+'   | xargs -I{} -n1 backup_file "{}"
    # $BIN/vcsh "${1}" pull 2>&1 | grep -E '^\s+\.' | xargs -I{} -n1 sh -c 'backup_file "{}"'
    # $BIN/vcsh "${1}" pull 2>&1 | grep -E '^\s+\.' | xargs -I{} -n1 bash -c 'backup_file "{}"'
    $BIN/vcsh "${1}" checkout master 2>&1 | grep -E '^\s+' | xargs -I{} -n1 bash -c 'backup_file "{}"'
    $BIN/vcsh "${1}" checkout master 2>&1 && $BIN/vcsh "${1}" pull && success "${1} successfully cloned after backup of conflicting files..." && return 0
  fi
  return 1
} #}}}

gitolite_vclone() { #{{{
  if $BIN/vcsh clone "gitolite:${1}-vcsh.git" "${1}"; then
    $BIN/vcsh "${REPO}" config get core.bare && $BIN/vcsh "${REPO}" config set core.bare false
    success "${1} successfully cloned..."
    return 0
  elif $BIN/vcsh "${1}" pull; then
    success "${1} successfully updated via pull..."
    return 0
  else
    error "Conflicting files found..."
    $BIN/vcsh "${1}" checkout master 2>&1 | grep -E '^\s+' | xargs -I{} -n1 bash -c 'backup_file "{}"'
    $BIN/vcsh "${1}" checkout master 2>&1 && $BIN/vcsh "${1}" pull && success "${1} successfully cloned after backup of conflicting files..." && return 0
  fi
} #}}}

localhost_vclone() { #{{{
  if $BIN/vcsh clone "${HOME}/git/${1}-vcsh.git" "${1}"; then
    $BIN/vcsh "${REPO}" config get core.bare && $BIN/vcsh "${REPO}" config set core.bare false
    success "${1} successfully cloned..."
    return 0
  elif $BIN/vcsh "${1}" pull; then
    success "${1} successfully updated via pull..."
    return 0
  else
    error "Conflicting files found..."
    $BIN/vcsh "${1}" checkout master 2>&1 | grep -E '^\s+' | xargs -I{} -n1 bash -c 'backup_file "{}"'
    $BIN/vcsh "${1}" checkout master 2>&1 && $BIN/vcsh "${1}" pull && success "${1} successfully cloned after backup of conflicting files..." && return 0
  fi
  return 1
} #}}}

install_caps2esc() { #{{{
  if [ -r /etc/interception/udevmon.yaml ]; then
    sudo mv /etc/interception/udevmon.yaml /etc/interception/udevmon.yaml-disabled
  fi
  if [ ! -r /etc/interception/udevmon.d/caps2esc.yml ]; then
    sudo mkdir -p /etc/interception/udevmon.d || exit 8
    {
      # shellcheck disable=SC2016
      echo '- JOB: intercept -g $DEVNODE | caps2esc | uinput -d $DEVNODE'
      echo '  DEVICE:'
      echo '    EVENTS:'
      echo '      EV_KEY: [KEY_CAPSLOCK, KEY_ESC]'
    } | sudo tee /etc/interception/udevmon.d/caps2esc.yml
  fi
  sudo systemctl enable --now udevmon
} #}}}

set_private_repos_tracking() { #{{{
  REPOS=(gnupg ssh)
  for REPO in "${REPOS[@]}"; do
    if [ -d "${HOME}/.${REPO}" ]; then
      cd "${HOME}/.${REPO}" && $BIN/git fetch origin && ($BIN/git branch -avv | grep master | grep -q '\[origin/master\]' || $BIN/git branch --set-upstream-to=origin/master)
    fi
  done

  REPOS=(private)
  for REPO in "${REPOS[@]}"; do
    if [ -d "$HOME/.config/vcsh/repo.d/${REPO}.git" ]; then
      $BIN/vcsh "${REPO}" fetch origin && ($BIN/vcsh "${REPO}" branch -avv | grep master | grep -q '\[origin/master\]' || $BIN/vcsh "${REPO}" branch --set-upstream-to=origin/master)
    fi
  done
} #}}}

setup_keychain() { #{{{
# start ssh-agent & load key
command -v keychain >/dev/null 2>&1 && eval "$(keychain --quiet --ignore-missing --eval id_rsa_"${MYHOST}" github_rsa id_rsa)"
[ -r "$HOME"/.keychain/"$(uname -n)"-sh ] && source "$HOME"/.keychain/"$(uname -n)"-sh
} #}}}

setup_tailscale() { #{{{
  # shellcheck disable=SC1091
  [[ -f ${HOME}/.SECRETS ]] && source "${HOME}/.SECRETS"
  [[ -f ${HOME}/TAILSCALE_KEY ]] && source "${HOME}/TAILSCALE_KEY"
  if isdarwin; then
    open tailscale-app
  elif isarch; then
    sudo systemctl enable --now tailscaled
    sudo tailscale status || sudo tailscale up --auth-key="${TAILSCALE_KEY}"
  elif isdebian; then
    echo "TODO"
    #TODO sudo systemctl enable --now tailscaled
    sudo tailscale status || sudo tailscale up --auth-key="${TAILSCALE_KEY}"
  elif isfedora; then
    echo "TODO"
    #TODO sudo systemctl enable --now tailscaled
    sudo tailscale status || sudo tailscale up --auth-key="${TAILSCALE_KEY}"
  else
    echo
    error "Unknown OS..."
    echo
    exit 10
  fi
} #}}}

install_AUR_pkg() { #{{{
  if [ ! -d "$HOME/.cache/AUR/$1" ]; then
    echo
    success "Installing $1..."
    paru -S "$1"
  fi
} #}}}

install_paru_customizepkg() { #{{{
  mkdir -p ~/.cache/AUR
  mkdir -p ~/.config/customizepkg
  export AURDEST=~/.cache/AUR
  export CUSTOMIZEPKG_CONFIG=~/.config/customizepkg

  if ! command -v paru >/dev/null; then
    if [ ! -d "${AURDEST}/paru" ]; then
      cd ~/.cache/AUR || exit 7
      $BIN/git clone https://aur.archlinux.org/paru.git
    fi
    cd "${AURDEST}/paru" && makepkg -sri && makepkg -code
  fi
  if [ ! -d "${AURDEST}/customizepkg-git" ]; then
    rm ~/.config/paru/paru.conf
    paru -S customizepkg-git
  fi
  if [ ! -f ~/.config/paru/paru.conf ]; then
    mkdir -p ~/.config/paru
    {
      echo "[options]"
      echo "BottomUp"
      echo "[bin]"
      echo "PreBuildCommand = customizepkg --modify"
    } >>~/.config/paru/paru.conf
  fi
} #}}}

install_remaining_pkgs() { #{{{
  # shellcheck disable=SC1091
  # [[ -f ${HOME}/.SECRETS ]] && source "${HOME}/.SECRETS"
  if isdarwin; then
    $BIN/brew install "${COMMON_PKGS[@]}" "${DARWIN_PKGS[@]}"
    [ "${MYHOST}" = "ariel" ] && $BIN/brew install p4v
  elif isarch; then
    sudo pacman -S --noconfirm --needed "${COMMON_PKGS[@]}" "${ARCH_PKGS[@]}"
    # sudo systemctl enable --now sshd.service
    # sudo systemctl enable --now tailscaled
    # sudo tailscale status || sudo tailscale up --auth-key="${TAILSCALE_KEY}"

    install_paru_customizepkg

    for AUR_PKG in "${AUR_PKGS[@]}"; do
      install_AUR_pkg "$AUR_PKG"
    done

  elif isdebian; then
    sudo apt-get update && sudo apt-get --yes install "${COMMON_PKGS[@]}" "${DEBIAN_PKGS[@]}"
  elif isfedora; then
    sudo dnf install "${COMMON_PKGS[@]}" "${FEDORA_PKGS[@]}"
  else
    echo
    error "Unknown OS..."
    echo
    exit 2
  fi
} #}}}

clone_private_repos() { #{{{
  echo
  echo "$(tput setaf 5)Please copy desired private repos ($(tput setaf 6)gnupg ssh private-vcsh$(tput setaf 5)) from IRONKEY to ~/git/"
  echo "          $(tput setaf 4)press the $(tput setaf 2)ENTER$(tput setaf 4) key to continue (or $(tput setaf 1)CTRL-C$(tput setaf 4) to abort)$(tput sgr0)"
  read -r _ </dev/tty

  REPOS=(gnupg ssh)
  for REPO in "${REPOS[@]}"; do
      find "${HOME}/.${REPO}" -type d -empty -delete
    if [ -d "${HOME}/git/${REPO}.git" ] && [ ! -d "${HOME}/.${REPO}" ]; then
      cd && $BIN/git clone "${HOME}/git/${REPO}.git" ".${REPO}" && chmod -R go= "${HOME}/.${REPO}"
      cd "${HOME}/.${REPO}" && $BIN/git remote rename origin localhost && $BIN/git remote add origin "gitolite:${REPO}.git"
    fi
  done

  REPOS=(private)
  for REPO in "${REPOS[@]}"; do
    # if [ -d "${HOME}/git/${REPO}-vcsh.git" ] && [ ! -d "$HOME/.config/vcsh/repo.d/${REPO}.git" ]; then
    if [ -d "${HOME}/git/${REPO}-vcsh.git" ]; then
      if localhost_vclone "${REPO}"; then
        cd "$HOME/.config/vcsh/repo.d/${REPO}.git" || return 1
        grep -q '\[remote "localhost"\]' config || $BIN/vcsh "${REPO}" remote rename origin localhost
        grep -q '\[remote "origin"\]' config || $BIN/vcsh "${REPO}" remote add origin "gitolite:${REPO}-vcsh.git"
      fi
    fi
  done
} #}}}

stow_dotfiles_pkgs() { #{{{
  local file
  for file in "${STOW_DOTFILES[@]}"; do
    if [ -f ~/"$file" ]; then
      if [ -L ~/"$file" ]; then continue; fi
      backup_file "$file"
    fi
  done

  isdarwin && $BIN/stow -d ~/.dotfiles/stow -t ~ -R darwin
  islinux && $BIN/stow -d ~/.dotfiles/stow -t ~ -R linux
  isarch && $BIN/stow -d ~/.dotfiles/stow -t ~ -R arch
  isdebian && $BIN/stow -d ~/.dotfiles/stow -t ~ -R debian
  isomarchy && $BIN/stow -d ~/.dotfiles/stow -t ~ -R omarchy
  iszsh && $BIN/stow -d ~/.dotfiles/stow -t ~ -R zsh
  [ "${MYHOST}" = "ariel" ] && $BIN/stow -d ~/.dotfiles/stow -t ~ -R ansible beets tmuxinator
  [ "${MYHOST}" = "theophilus" ] && $BIN/stow -d ~/.dotfiles/stow -t ~ -R i3 x11
  $BIN/stow -d ~/.dotfiles/stow -t ~ -R "${MYHOST}" direnv duplicacy home liquidprompt mr tmux vcsh vim
  $BIN/stow -d ~/.dotfiles/stow -t ~ -R "${MYHOST}" ghostty kitty starship
  #TODO
  # $BIN/stow -d ~/.dotfiles/stow -t ~ -R "${MYHOST}" git mise
} #}}}

setup_etckeeper() { #{{{
  if [ ! -d /etc/.git ]; then
    cd /etc || exit 4
    sudo etckeeper init
    sudo $BIN/git config user.email "root@$(uname -n)"
    sudo $BIN/git config user.name "root"
    sudo etckeeper commit 'Initial commit'
  fi
} #}}}

check_installed_commands() { #{{{
  # shellcheck disable=SC2015
  command -v curl >/dev/null 2>&1 &&
    command -v sudo >/dev/null 2>&1 &&
    command -v git >/dev/null 2>&1 &&
    command -v mr >/dev/null 2>&1 &&
    command -v stow >/dev/null 2>&1 &&
    command -v vcsh >/dev/null 2>&1 ||
    {
      echo
      echo "Edit bootstrap to install required commands..."
      echo
      exit 6
    }
} #}}}

install_required_pkgs() { #{{{
  if isdarwin; then
    $BIN/brew doctor || true
    echo
    $BIN/brew install bash bash-completion@2 zsh-completions "${REQUIRED_PKGS[@]}"
    $BIN/brew completions link
  elif isarch; then
    sudo sed -i 's/^#Color$/Color/' /etc/pacman.conf
    sudo sed -i 's/^#ParallelDownloads/ParallelDownloads/' /etc/pacman.conf
    sudo pacman -Syu --noconfirm --needed "${REQUIRED_PKGS[@]}" etckeeper
  elif isdebian; then
    sudo apt-get update && sudo apt-get --yes install "${REQUIRED_PKGS[@]}" etckeeper
  elif isfedora; then
    sudo dnf install "${REQUIRED_PKGS[@]}" etckeeper
  else
    echo
    error "Unknown OS..."
    echo
    exit 5
  fi
} #}}}

clone_dotfiles_repo() { #{{{
  if [ ! "$(id -u)" -eq 0 ] && [ ! -d "$HOME/.dotfiles" ]; then
    $BIN/git clone https://github.com/tomhoover/dotfiles ~/.dotfiles
  else
    (
      cd ~/.dotfiles || exit 3
      $BIN/git pull --rebase --autostash
    )
  fi
} #}}}

BIN="/usr/bin"
if isdarwin; then
  [ -r /usr/local/bin/brew ] && BIN="/usr/local/bin"
  [ -r /opt/homebrew/bin/brew ] && BIN="/opt/homebrew/bin"
fi

case "$1" in #{{{
"") ;;
clone_dotfiles_repo)
  "$@"
  exit
  ;;
stow_dotfiles_pkgs)
  "$@"
  exit
  ;;
update)
  clone_dotfiles_repo
  stow_dotfiles_pkgs
  exit
  ;;
*)
  log_error "Unkown function: $1()"
  exit 9
  ;;
esac
#}}}

# Always prompt for sudo password at least once
sudo --reset-timestamp

clone_dotfiles_repo
install_required_pkgs
check_installed_commands
! isdarwin && setup_etckeeper
stow_dotfiles_pkgs
clone_private_repos
# github_vclone dotfiles
install_remaining_pkgs
# run the following after .ssh repo is cloned
create_ssh_key
setup_keychain
setup_tailscale
set_private_repos_tracking
isarch && install_caps2esc
# isarch && ~/.dotfiles/script/arch
isdebian && clone_apt_vcsh

echo
# cd && $BIN/mr -m -j 1 up

# install development tools
if [ ! "$(id -u)" -eq 0 ] && [[ "${MYHOST}" =~ (ariel|theophilus) ]]; then
  echo
  ~/.dotfiles/script/install-dev-tools
fi

echo
info "##### bootstrap completed - please reboot computer #####"

if [ $NEW_SSH_KEY ]; then
    echo
    echo "$(tput setaf 1)Commit id_rsa_${MYHOST}* to .ssh repo$(tput sgr0)"
    echo "$(tput setaf 1)Copy id_rsa_${MYHOST}.pub to gitea & gitolite-admin$(tput sgr0)"
fi

if ! iszsh; then
  echo
  echo "$(tput setaf 1)chsh -s $(which zsh)$(tput sgr0)"
  echo
  echo "Execute above command to change shell. Then, logout and login to re-read configuration."
fi

echo

# vim: set tw=120 fdm=marker commentstring=#%s:
