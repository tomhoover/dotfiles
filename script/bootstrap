#!/usr/bin/env bash

[ "$(id -u)" -eq 0 ] && {
  echo "Run $0 as yourself (not as root), exiting"
  exit 1
}

MYHOST=$(uname -n | sed -e 's/\..*//') # alternative to $(hostname -s), as arch does not install 'hostname' by default

REQUIRED_PKGS=( #{{{
  git
  myrepos
  vcsh
) #}}}

COMMON_PKGS=( #{{{
  colordiff
  diff-so-fancy
  keychain
  mosh
  tmux
  vim
) #}}}

ARCH_PKGS=( #{{{
  tailscale
  zsh
) #}}}

AUR_PKGS=( #{{{
  brave-bin
  vi-vim-symlink
) #}}}

DARWIN_PKGS=( #{{{
) #}}}

DEBIAN_PKGS=( #{{{
  tailscale
  zsh
) #}}}

iszsh()
{ #{{{
  [ "${SHELL}" = "/bin/zsh" ]
} #}}}

isdarwin()
{ #{{{
  [ "$(uname -s)" = "Darwin" ]
} #}}}

islinux()
{ #{{{
  [ "$(uname -s)" = "Linux" ]
} #}}}

isarch()
{ #{{{
  if islinux && [ -f /etc/os-release ]; then
    # shellcheck disable=SC1091
    source /etc/os-release
    # shellcheck disable=SC2078
    [ "${ID}" = "arch" ] && return 0
  fi
  return 1
} #}}}

isdebian()
{ #{{{
  if islinux && [ -f /etc/os-release ]; then
    # shellcheck disable=SC1091
    source /etc/os-release
    # shellcheck disable=SC2078
    [ "${ID}" = "debian" ] && return 0
  fi
  return 1
} #}}}

isomarchy()
{ #{{{
  isarch && grep -q '\[omarchy\]' /etc/pacman.conf
} #}}}

create_ssh_key()
{ #{{{
  if [ ! "$(id -u)" -eq 0 ] && [ ! -f ~/.ssh/id_rsa_"${MYHOST}".pub ]; then
    echo && ssh-keygen -t rsa -b 4096 -C "$(whoami)@${MYHOST}" -f "${HOME}"/.ssh/id_rsa_"${MYHOST}"
    echo
    echo "$(tput setaf 1)Commit id_rsa_${MYHOST}* to .ssh repo$(tput sgr0)"
    echo "$(tput setaf 1)Copy id_rsa_${MYHOST}.pub to gitea & gitolite-admin$(tput sgr0)"
  fi
} #}}}

clone_apt_vcsh()
{ #{{{
  if isdebian; then
    github_vclone apt
    sudo aptitude install "$(cat ~/.config/apt/installed)"
    sudo apt-mark manual "$(cat ~/.config/apt/installed)" # this line is probably not needed, but added for good measure
  fi
} #}}}

# shellcheck disable=SC2329
backup_file()
{ #{{{
  echo "$(tput setaf 2)Backing up ${1}...$(tput sgr0)"
  # shellcheck disable=SC2086
  mkdir -p "$HOME/.config-backup-$(date '+%Y%m%d')/$(dirname ${1})"
  # shellcheck disable=SC2086
  mv "$HOME/${1}" "$HOME/.config-backup-$(date '+%Y%m%d')/$(dirname ${1})"
  echo "nvim -d $HOME/.config-backup-$(date '+%Y%m%d')/${1} $HOME/${1}" >>"$HOME/fixups.sh"
} #}}}

# # bash/zsh function exporting shortcut
export -f backup_file

# Export the function (POSIX syntax -- preserve newlines and syntax!)
# shellcheck disable=SC2016
# export backup_file='backup_file()
# {
#   echo "Backing up ${1}..."
#   mkdir -p "$HOME/.config-backup-$(date '+%Y%m%d')/$(dirname ${1})"
#   mv "$HOME/${1}" "$HOME/.config-backup-$(date '+%Y%m%d')/$(dirname ${1})"
#   echo "nvim -d $HOME/.config-backup-$(date '+%Y%m%d')/${1} ${1}" >>"$HOME/fixups.sh"
# }'

github_vclone()
{ #{{{
  if "$BIN/vcsh" clone "https://github.com/tomhoover/${1}-vcsh.git" "${1}"; then
    $BIN/vcsh "${REPO}" config get core.bare && $BIN/vcsh "${REPO}" config set core.bare false
    echo "$(tput setaf 2)${1} successfully cloned...$(tput sgr0)"
    return 0
  elif "$BIN/vcsh" "${1}" pull; then
    echo "$(tput setaf 2)${1} successfully updated via pull...$(tput sgr0)"
    return 0
  else
    echo "$(tput setaf 1)conflicting files found...$(tput sgr0)"
    # "$BIN/vcsh" "${1}" pull 2>&1 | grep -E '^\s+'   | xargs -I{} -n1 backup_file "{}"
    # "$BIN/vcsh" "${1}" pull 2>&1 | grep -E '^\s+\.' | xargs -I{} -n1 sh -c 'backup_file "{}"'
    # "$BIN/vcsh" "${1}" pull 2>&1 | grep -E '^\s+\.' | xargs -I{} -n1 bash -c 'backup_file "{}"'
    "$BIN/vcsh" "${1}" checkout master 2>&1 | grep -E '^\s+' | xargs -I{} -n1 bash -c 'backup_file "{}"'
    "$BIN/vcsh" "${1}" checkout master 2>&1 && "$BIN/vcsh" "${1}" pull && echo "$(tput setaf 2)${1} successfully cloned after backup of conflicting files...$(tput sgr0)" && return 0
  fi
  return 1
} #}}}

gitolite_vclone()
{ #{{{
  if "$BIN/vcsh" clone "gitolite:${1}-vcsh.git" "${1}"; then
    $BIN/vcsh "${REPO}" config get core.bare && $BIN/vcsh "${REPO}" config set core.bare false
    echo "$(tput setaf 2)${1} successfully cloned...$(tput sgr0)"
    return 0
  elif "$BIN/vcsh" "${1}" pull; then
    echo "$(tput setaf 2)${1} successfully updated via pull...$(tput sgr0)"
    return 0
  else
    echo "$(tput setaf 1)conflicting files found...$(tput sgr0)"
    "$BIN/vcsh" "${1}" checkout master 2>&1 | grep -E '^\s+' | xargs -I{} -n1 bash -c 'backup_file "{}"'
    "$BIN/vcsh" "${1}" checkout master 2>&1 && "$BIN/vcsh" "${1}" pull && echo "$(tput setaf 2)${1} successfully cloned after backup of conflicting files...$(tput sgr0)" && return 0
  fi
} #}}}

localhost_vclone()
{ #{{{
  if "$BIN/vcsh" clone "${HOME}/git/${1}-vcsh.git" "${1}"; then
    $BIN/vcsh "${REPO}" config get core.bare && $BIN/vcsh "${REPO}" config set core.bare false
    echo "$(tput setaf 2)${1} successfully cloned...$(tput sgr0)"
    return 0
  elif "$BIN/vcsh" "${1}" pull; then
    echo "$(tput setaf 2)${1} successfully updated via pull...$(tput sgr0)"
    return 0
  else
    echo "$(tput setaf 1)conflicting files found...$(tput sgr0)"
    "$BIN/vcsh" "${1}" checkout master 2>&1 | grep -E '^\s+' | xargs -I{} -n1 bash -c 'backup_file "{}"'
    "$BIN/vcsh" "${1}" checkout master 2>&1 && "$BIN/vcsh" "${1}" pull && echo "$(tput setaf 2)${1} successfully cloned after backup of conflicting files...$(tput sgr0)" && return 0
  fi
  return 1
} #}}}

set_private_repos_tracking()
{ #{{{
  REPOS=(gnupg ssh)
  for REPO in "${REPOS[@]}"; do
    if [ -d "${HOME}/.${REPO}" ]; then
      cd "${HOME}/.${REPO}" && "$BIN/git" fetch origin && ($BIN/git branch -avv | grep master | grep -q '\[origin/master\]' || "$BIN/git" branch --set-upstream-to=origin/master)
    fi
  done

  REPOS=(private)
  for REPO in "${REPOS[@]}"; do
    if [ -d "$HOME/.config/vcsh/repo.d/${REPO}.git" ]; then
      $BIN/vcsh "${REPO}" fetch origin && ($BIN/vcsh "${REPO}" branch -avv | grep master | grep -q '\[origin/master\]' || $BIN/vcsh "${REPO}" branch --set-upstream-to=origin/master)
    fi
  done
} #}}}

install_AUR_pkg()
{ #{{{
  if [ ! -d "$HOME/.cache/AUR/$1" ]; then
    echo
    echo "$(tput setaf 1)Installing $1...$(tput sgr0)"
    paru -S "$1"
  fi
} #}}}

install_paru_customizepkg()
{ #{{{

  mkdir -p ~/.cache/AUR
  mkdir -p ~/.config/customizepkg
  # grep AURDEST ~/.exports >/dev/null || grep AURDEST ~/.bashrc >/dev/null || echo "export AURDEST=~/.cache/AUR" >>~/.bashrc
  # grep CUSTOMIZEPKG_CONFIG ~/.exports >/dev/null || grep CUSTOMIZEPKG_CONFIG ~/.bashrc >/dev/null || echo "export CUSTOMIZEPKG_CONFIG=~/.config/customizepkg" >>~/.bashrc

  # shellcheck source=/dev/null
  source ~/.bashrc

  command -v paru >/dev/null || (cd ~/.cache/AUR && git clone https://aur.archlinux.org/paru-bin.git && cd paru-bin && makepkg -si)

  if [ ! -d "$HOME/.cache/AUR/customizepkg-git" ]; then
    rm ~/.config/paru/paru.conf
    paru -S customizepkg-git
  fi

  if [ ! -f ~/.config/paru/paru.conf ]; then
    mkdir -p ~/.config/paru
    {
      echo "[options]"
      echo "BottomUp"
      echo "[bin]"
      echo "PreBuildCommand = customizepkg --modify"
    } >>~/.config/paru/paru.conf
  fi
} #}}}

install_remaining_pkgs()
{ #{{{
  # shellcheck disable=SC1091
  [[ -f ${HOME}/.SECRETS ]] && source "${HOME}/.SECRETS"
  if isdarwin; then
    # shellcheck disable=SC2086
    "$BIN/brew" install "${COMMON_PKGS[@]}" "${DARWIN_PKGS[@]}"
  elif isarch; then
    # shellcheck disable=SC2086
    sudo pacman -S --noconfirm --needed "${COMMON_PKGS[@]}" "${ARCH_PKGS[@]}"
    # sudo systemctl enable --now sshd.service
    sudo systemctl enable --now tailscaled
    sudo tailscale status || sudo tailscale up --auth-key="${TAILSCALE_KEY}"

    install_paru_customizepkg

    for AUR_PKG in "${AUR_PKGS[@]}"; do
      install_AUR_pkg "$AUR_PKG"
    done

  elif isdebian; then
    # shellcheck disable=SC2086
    sudo apt-get update && sudo apt-get --yes install "${COMMON_PKGS[@]}" "${DEBIAN_PKGS[@]}"
  else
    echo
    echo "$(tput setaf 1)Unknown OS...$(tput sgr0)"
    echo
    exit 2
  fi
} #}}}

clone_private_repos()
{ #{{{
  echo
  echo "$(tput setaf 5)Please copy desired private repos ($(tput setaf 6)gnupg ssh private-vcsh$(tput setaf 5)) from IRONKEY to ~/git/"
  echo "          $(tput setaf 4)press the $(tput setaf 2)ENTER$(tput setaf 4) key to continue (or $(tput setaf 1)CTRL-C$(tput setaf 4) to abort)$(tput sgr0)"
  read -r _

  REPOS=(gnupg ssh)
  for REPO in "${REPOS[@]}"; do
    if [ -d "${HOME}/git/${REPO}.git" ] && [ ! -d "${HOME}/.${REPO}" ]; then
      cd && "$BIN/git" clone "${HOME}/git/${REPO}.git" ".${REPO}" && chmod -R go= "${HOME}/.${REPO}"
      cd "${HOME}/.${REPO}" && "$BIN/git" remote rename origin localhost && "$BIN/git" remote add origin "gitolite:${REPO}.git"
    fi
  done

  REPOS=(private)
  for REPO in "${REPOS[@]}"; do
    # if [ -d "${HOME}/git/${REPO}-vcsh.git" ] && [ ! -d "$HOME/.config/vcsh/repo.d/${REPO}.git" ]; then
    if [ -d "${HOME}/git/${REPO}-vcsh.git" ]; then
      if localhost_vclone "${REPO}"; then
        cd "$HOME/.config/vcsh/repo.d/${REPO}.git" || return 1
        grep -q '\[remote "localhost"\]' config || $BIN/vcsh "${REPO}" remote rename origin localhost
        grep -q '\[remote "origin"\]' config || "$BIN/vcsh" "${REPO}" remote add origin "gitolite:${REPO}-vcsh.git"
      fi
    fi
  done
} #}}}

check_installed_commands()
{ #{{{
  # shellcheck disable=SC2015
  command -v curl >/dev/null 2>&1 \
    && command -v sudo >/dev/null 2>&1 \
    && command -v git >/dev/null 2>&1 \
    && command -v mr >/dev/null 2>&1 \
    && command -v vcsh >/dev/null 2>&1 \
    || {
      echo
      echo "Edit bootstrap to install required commands..."
      echo
      exit 6
    }
} #}}}

setup_etckeeper()
{ #{{{
  if [ ! -d /etc/.git ]; then
    cd /etc || exit 4
    sudo etckeeper init
    sudo git config user.email "root@$(uname -n)"
    sudo git config user.name "root"
    sudo etckeeper commit 'Initial commit'
  fi
} #}}}

install_required_pkgs()
{ #{{{
  if isdarwin; then
    "$BIN/brew" doctor || true
    # shellcheck disable=SC2086
    "$BIN/brew" install "${REQUIRED_PKGS[@]}"
  elif isarch; then
    sudo sed -i 's/^#Color$/Color/' /etc/pacman.conf
    sudo sed -i 's/^#ParallelDownloads/ParallelDownloads/' /etc/pacman.conf
    # shellcheck disable=SC2086
    sudo pacman -Syu --noconfirm --needed "${REQUIRED_PKGS[@]}" etckeeper
  elif isdebian; then
    # shellcheck disable=SC2086
    sudo apt-get update && sudo apt-get --yes install "${REQUIRED_PKGS[@]}" etckeeper
  else
    echo
    echo "$(tput setaf 1)Unknown OS...$(tput sgr0)"
    echo
    exit 5
  fi

  ! isdarwin && setup_etckeeper
} #}}}

clone_dotfiles_repo()
{ #{{{
  if [ ! "$(id -u)" -eq 0 ] && [ ! -d "$HOME/.dotfiles" ]; then
    git clone https://github.com/tomhoover/dotfiles ~/.dotfiles
  else
    (
      cd ~/.dotfiles || exit 3
      git pull --rebase --autostash
    )
  fi
} #}}}

BIN="/usr/bin"
if isdarwin; then
  [ -r /usr/local/bin/brew ] && BIN="/usr/local/bin"
  [ -r /opt/homebrew/bin/brew ] && BIN="/opt/homebrew/bin"
fi

# Always prompt for sudo password at least once
sudo --reset-timestamp

clone_dotfiles_repo
install_required_pkgs
# check_installed_commands
clone_private_repos
github_vclone dotfiles
install_remaining_pkgs
set_private_repos_tracking
# isarch && ~/.dotfiles/script/arch
isdebian && clone_apt_vcsh

echo
cd && "$BIN/mr" -m -j 1 up

echo
if [ ! "$(id -u)" -eq 0 ]; then
  ~/.dotfiles/script/install
fi

echo
echo "$(tput setaf 2)##### bootstrap completed #####$(tput sgr0)"

# run the following after .ssh repo is cloned
create_ssh_key

if ! iszsh; then
  echo
  echo "$(tput setaf 1)chsh -s $(which zsh)$(tput sgr0)"
  echo
  echo "Execute above command to change shell. Then, logout and login to re-read configuration."
fi

echo

# vim: set tw=120 fdm=marker commentstring=#%s:
